  <transmission name="tran_gripper_2"> <type>transmission_interface/SimpleTransmission</type> <joint name="gripper_2"> <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface> </joint> <actuator name="motor_gripper_2"> <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface> <mechanicalReduction>1</mechanicalReduction> </actuator> </transmission>
  
  <!-- ================= GAZEBO PLUGINS (Unchanged + Added ros_control) ================= -->
  <gazebo>
    <plugin name="gazebo_ros_planar_move" filename="libgazebo_ros_planar_move.so">
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <odometryRate>20.0</odometryRate>
      <robotBaseFrame>base_link</robotBaseFrame>
      <publishTF>true</publishTF>
      <enable-xy>true</enable-xy>
      <enable-rotation>true</enable-rotation>
      <front_left_joint>left_wheel_1</front_left_joint>
      <front_right_joint>right_wheel_1</front_right_joint>
      <back_left_joint>left_wheel_2</back_left_joint>
      <back_right_joint>right_wheel_2</back_right_joint>
      <wheel_separation_x>0.314</wheel_separation_x>
      <wheel_separation_y>0.248</wheel_separation_y>
      <wheel_radius>0.05</wheel_radius>
      <x_p_gain>1.0</x_p_gain> <x_i_gain>0.1</x_i_gain> <x_d_gain>0.01</x_d_gain>
      <y_p_gain>1.0</y_p_gain> <y_i_gain>0.1</y_i_gain> <y_d_gain>0.01</y_d_gain>
      <rot_p_gain>1.0</rot_p_gain> <rot_i_gain>0.1</rot_i_gain> <rot_d_gain>0.01</rot_d_gain>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/sarm</robotNamespace>
    </plugin>
  </gazebo>

  <!-- ================= GAZEBO MATERIALS (Unchanged) ================= -->
  <gazebo reference="base_link"><material>Gazebo/Red</material></gazebo>
  <gazebo reference="l_w_1"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="l_w_2"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="r_w_1"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="r_w_2"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="b_l_r_a"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="b_c"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="l_1"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="l_2"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="l_3"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="g_1"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="l_4_1"><material>Gazebo/Blue</material></gazebo>
